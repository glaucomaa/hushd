<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install-macos.sh replaces __M4D__ with the daemon inside M4.app and
     __SOCKET__ with the per-user IPC socket, then installs this file as
     ~/Library/LaunchAgents/dev.m4.m4d.plist. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.m4.m4d</string>
    <key>ProgramArguments</key>
    <array>
        <string>__M4D__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>M4D_SOCKET</key>
        <string>__SOCKET__</string>
    </dict>
</dict>
</plist>
